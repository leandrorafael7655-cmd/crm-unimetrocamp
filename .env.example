# ─────────────────────────────────────────────────────────────
# UniConecta — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione segredos.
# ─────────────────────────────────────────────────────────────

# Supabase (injetadas automaticamente pela integração Vercel/Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only: nunca exponha no cliente

# URL de redirect do Supabase Auth em dev (proxy v0)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# URL pública do site (opcional). Usada para montar redirects de auth.
# Em produção a Vercel injeta VERCEL_PROJECT_PRODUCTION_URL automaticamente.
# Após configurar e validar o domínio: https://uniconecta-crm.vercel.app
NEXT_PUBLIC_SITE_URL=

# Ative só após validar domínio, login e recuperação no novo endereço.
# Mantém callbacks de autenticação, APIs e POSTs no domínio de origem.
UNICONECTA_REDIRECT_LEGACY_HOST=false

# ─── Bootstrap do primeiro admin (Fase 2 — /setup) ────────────
# Se definida, o /setup só promove a admin o e-mail exato aqui informado.
# Deixe em branco para permitir o primeiro cadastro assumir admin.
INITIAL_ADMIN_EMAIL=

# ─── Mapbox (Fase 4 — Mapa) ───────────────────────────────────
# Token PÚBLICO (pk....): vai ao bundle do cliente para renderizar tiles.
# Restrinja por domínio (URL allowlist) no painel Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Token de GEOCODING (server-only): usado apenas em Server Actions para
# Geocoding e Optimization. Idealmente um sk...., mas aceita um pk....
# sem restrição de URL. NUNCA é importado em código de cliente.
MAPBOX_SECRET_TOKEN=

# ─── Cron (fechamento semanal + retry de calendário) ──────────
# Injetado automaticamente pela Vercel quando há crons configurados.
CRON_SECRET=

# ─── Convites de calendário (Supabase Edge Function) ──────────
# Secrets server-only configurados no Supabase. Não use NEXT_PUBLIC_.
CALENDAR_EMAIL_PROVIDER=smtp
CALENDAR_SMTP_HOST=
CALENDAR_SMTP_PORT=587
CALENDAR_SMTP_USER=
CALENDAR_SMTP_PASS=
CALENDAR_SMTP_SECURE=false
CALENDAR_FROM_EMAIL=
# Opcional; por padrão usa o remetente.
CALENDAR_ORGANIZER_EMAIL=
# Após a migração, configure https://uniconecta-crm.vercel.app.
# Sem configuração, mantém o endereço legado durante a transição.
CALENDAR_CRM_URL=
